FLASK_ENV=development
SECRET_KEY=change-me-dev-secret
JWT_SECRET_KEY=change-me-jwt-secret-at-least-32-chars!!
DATABASE_URL=sqlite:///courseforge.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
ARTIFACTS_DIR=artifacts
# Static PPTX until a PPT agent is wired — place files in ppt/ (copied, never edited).
PPT_TEMPLATE_DIR=ppt
# Optional: force one file, e.g. ppt/Advanced Topic- 2.Access Token Management.pptx
# PPT_TEMPLATE_FILE=
# LibreOffice for faithful slide previews (PPTX→PDF→PNG). Example Windows path:
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.com
JOB_STUB_DELAY_SECONDS=2
PORT=8080

# ── Agent Microservice Endpoints (one per standalone agent server) ────────────
# Endpoint URL for PPTX Agent (generates and builds the PowerPoint presentation .pptx binary)
AGENT_PPTX_URL=http://localhost:8001/build-pptx

# Endpoint URL for Lab Agent (generates the hands-on practical lab exercises, tasks, and criteria)
AGENT_LAB_URL=http://localhost:8002/generate-lab

# Endpoint URL for Lab Guide Agent (generates step-by-step lab guides and walkthrough documentation)
AGENT_LAB_GUIDE_URL=http://localhost:8003/generate-guide

# HTTP request timeout in seconds when calling external agent microservices
AGENT_TIMEOUT_SECONDS=30

# Set to true to strictly require all 3 agent URLs at startup instead of using local dev fallbacks
REQUIRE_AGENT_ENDPOINTS=false
