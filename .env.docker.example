# Docker Compose Environment Configuration Overrides (.env)
# Copy this file to .env (or pass with --env-file) to customize container settings.

# Backend secrets
SECRET_KEY=production-secret-change-me
JWT_SECRET_KEY=production-jwt-secret-change-me

# External Agent Microservices
# By default, docker-compose points to the internal mock-agents service:
# AGENT_PPTX_URL=http://mock-agents:8001/build-pptx
# AGENT_LAB_URL=http://mock-agents:8002/generate-lab
# AGENT_LAB_GUIDE_URL=http://mock-agents:8003/generate-guide

# To point to external standalone agent servers running on the host machine:
# AGENT_PPTX_URL=http://host.docker.internal:8001/build-pptx
# AGENT_LAB_URL=http://host.docker.internal:8002/generate-lab
# AGENT_LAB_GUIDE_URL=http://host.docker.internal:8003/generate-guide

# Agent timeout & strict mode
AGENT_TIMEOUT_SECONDS=30
REQUIRE_AGENT_ENDPOINTS=false
